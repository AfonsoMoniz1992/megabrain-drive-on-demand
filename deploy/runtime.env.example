# Non-secret broker configuration. Copy to /etc/gdrive-stream-broker/runtime.env
# and replace every angle-bracketed value. Do not put secrets in this file.

PORT=34003
GDRIVE_STREAM_ADMIN_PORT=34004
GDRIVE_STREAM_GATEWAY_PORT=34005
GDRIVE_STREAM_PRIVATE_GATEWAY_PORT=34006

GDRIVE_STREAM_GOOGLE_OAUTH_CLIENT_ID=<public-oauth-client-id>
GDRIVE_STREAM_GOOGLE_OAUTH_REDIRECT_URI=https://<public-host>/gdrive-stream-oauth/google/callback
GDRIVE_STREAM_GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/drive.readonly

GDRIVE_STREAM_OAUTH_CLIENT_SECRET_FILE=/etc/gdrive-stream-broker/secrets/oauth-client-secret
GDRIVE_STREAM_ADMIN_TOKEN_FILE=/etc/gdrive-stream-broker/secrets/admin-token
GDRIVE_STREAM_TOKEN_KEY_FILE=/etc/gdrive-stream-broker/secrets/token-key

GDRIVE_STREAM_REFRESH_TOKEN_PATH=/var/lib/gdrive-stream-broker/refresh-token.bin
GDRIVE_STREAM_ENROLLMENT_PATH=/var/lib/gdrive-stream-broker/enrollment.bin

# Required — the broker has no default root and refuses to start without this.
# Use a dedicated harmless beta root, never a production vault.
# The plugin's "Allowed Drive test root" setting must name this same folder:
# the broker seals it into every lease and the plugin rejects any other root.
GDRIVE_STREAM_ALLOWED_ROOT_NAME=<unique-harmless-test-root>
